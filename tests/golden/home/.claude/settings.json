{
  "permissions": {
    "allow": [
      "Bash(fixture-tool status *)",
      "Bash(fixture-tool -C* status *)",
      "Bash(fixture-tool -C* status)",
      "Read(**)",
      "WebFetch(*)",
      "mcp__fixture-local__inspect",
      "mcp__fixture-optional__lookup"
    ],
    "ask": [
      "Bash(fixture-tool publish --public *)",
      "Bash(fixture-tool publish * --public *)",
      "Bash(fixture-tool publish * --public)",
      "Bash(fixture-tool -* publish --public *)",
      "Bash(fixture-tool -* publish --public)",
      "Bash(fixture-tool -* publish * --public *)",
      "Bash(fixture-tool -* publish * --public)",
      "WebSearch(*)",
      "Read(//tmp/fixture-review/**)",
      "Edit(//tmp/fixture-review/**)",
      "mcp__fixture-local__submit"
    ],
    "deny": [
      "Bash(fixture-tool remove)",
      "Bash(fixture-tool -* remove)",
      "Bash(*FIXTURE_TOKEN*)",
      "Read(//**/.env)",
      "Edit(//**/.env)",
      "Edit(**)",
      "mcp__fixture-local__erase"
    ],
    "additionalDirectories": [
      "~/fixture-shared"
    ]
  },
  "sandbox": {
    "credentials": {
      "envVars": [
        {
          "name": "FIXTURE_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); printf %s \"$input\" | <tmp>/home/.claude/hooks/shell-unwrap claude 2>/dev/null || case $input in *'\"permission_mode\":\"bypassPermissions\"'*) ;; *) printf %s '{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"ask\", \"permissionDecisionReason\": \"shell-unwrap could not run, so its guards were not checked\"}}' ;; esac",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "fixture": {
    "claude": true
  }
}
