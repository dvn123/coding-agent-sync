{
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "fixture-tool status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "fixture-tool -C* status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "fixture-tool publish --public *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "fixture-tool publish * --public *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "fixture-tool -C* publish --public *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "fixture-tool -C* publish * --public *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "env fixture-tool publish --public *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "env fixture-tool publish * --public *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "env fixture-tool -C* publish --public *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "env fixture-tool -C* publish * --public *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "env * fixture-tool publish --public *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "env * fixture-tool publish * --public *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "env * fixture-tool -C* publish --public *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "env * fixture-tool -C* publish * --public *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "fixture-tool remove",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "fixture-tool -C* remove",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*FIXTURE_TOKEN*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "**/.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "**/.env",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "~/fixture-shared/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/fixture-review/**",
      "effect": "ask"
    }
  ],
  "mcp": {
    "servers": {
      "fixture-local": {
        "type": "local",
        "command": [
          "fixture-mcp",
          "--stdio"
        ],
        "environment": {
          "FIXTURE_MODE": "neutral"
        }
      },
      "fixture-remote": {
        "type": "remote",
        "url": "https://mcp.example.test/mcp"
      }
    }
  },
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ],
  "fixture": {
    "opencode": true
  }
}
